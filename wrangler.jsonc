{
  "compatibility_date": "2025-10-08",
  "main": "src/variant-entry.ts",
  "name": "igstore-whatsapp-bot",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *",
      "0 */6 * * *"
    ]
  },
  "vars": {
    "SHOPIFY_ADMIN_DOMAIN": "nnruh1-fa.myshopify.com",
    "SHOPIFY_CLIENT_ID": "2b873ac6c1738dc7b8b99b236ab65569",
    "ABANDONED_TEMPLATE_FIRST": "ig_abandoned_cart_1",
    "ABANDONED_TEMPLATE_SECOND": "ig_abandoned_cart_5",
    "ABANDONED_TEMPLATE_THIRD": "ig_abandoned_cart_10",
    "ABANDONED_TEMPLATE_LANGUAGE": "en_US",
    "ABANDONED_OFFER_CODE": "CART5",
    "ABANDONED_FINAL_OFFER_CODE": "CART10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db",
      "database_id": "004b2d1b-e003-48d6-baca-43a29e96d31f"
    }
  ]
}
